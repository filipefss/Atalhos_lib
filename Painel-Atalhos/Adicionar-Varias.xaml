<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Adicionar vários atalhos" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" ShowInTaskbar="False">
 <StackPanel Margin="20"><TextBlock Text="Cole um destino por linha, ou use Nome | destino." Margin="0,0,0,7" /><TextBlock Text="Exemplo: Financeiro | \\servidor\financeiro" FontSize="11" Foreground="#AFBFD3" Margin="0,0,0,7" /><TextBox x:Name="BatchInput" Height="200" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,0,0,14" /><TextBlock Text="Grupo para estes atalhos" Margin="0,0,0,7" /><TextBox x:Name="GroupInput" Text="Geral" MaxLength="80" Margin="0,0,0,14" /><TextBlock x:Name="ErrorText" Text="" Foreground="#F4BF66" TextWrapping="Wrap" Margin="0,0,0,12" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" Style="{StaticResource QuietButtonStyle}" /><Button x:Name="SaveButton" Content="Adicionar" Style="{StaticResource PrimaryButtonStyle}" /></StackPanel></StackPanel>
</Window>