<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Meus atalhos" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" SizeToContent="WidthAndHeight" ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI">
 <Viewbox x:Name="FitBox" Stretch="Uniform" StretchDirection="DownOnly"><Border Width="480" Background="{DynamicResource Surface}" BorderBrush="#344457" BorderThickness="1" CornerRadius="18" Padding="20" Margin="10"><Border.Effect><DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="18" ShadowDepth="4" /></Border.Effect><StackPanel>
  <Grid x:Name="Header" Background="Transparent" Cursor="SizeAll" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SEU ESPAÇO DE TRABALHO" Foreground="{DynamicResource Muted}" FontSize="10" /><TextBlock Text="Meus atalhos" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="Seus destinos favoritos, a um clique." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0" /></StackPanel><Button x:Name="CloseButton" Grid.Column="1" Content="×" Width="30" Height="30" FontSize="20" VerticalAlignment="Top" Margin="0" ToolTip="Fechar painel" Style="{StaticResource QuietButtonStyle}" Padding="0" /></Grid>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button x:Name="AddButton" Content="+ Novo atalho" Style="{StaticResource PrimaryButtonStyle}" /><Button x:Name="BatchButton" Content="Adicionar vários" /><Button x:Name="ImportButton" Content="Importar" Style="{StaticResource QuietButtonStyle}" /><Button x:Name="ExportButton" Content="Exportar" Margin="0" Style="{StaticResource QuietButtonStyle}" /></StackPanel>
  <TextBlock Text="BUSCAR E FILTRAR" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,2,0,6" /><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="125" /></Grid.ColumnDefinitions><TextBox x:Name="Search" ToolTip="Buscar por nome, grupo ou destino" Height="36" /><ComboBox x:Name="Groups" Grid.Column="1" Margin="8,0,0,0" VerticalContentAlignment="Center" SelectedIndex="0" Height="36" FontSize="11" /></Grid>
  <UniformGrid x:Name="Tiles" Columns="2" />
  <TextBlock x:Name="EmptyText" Text="Adicione seu primeiro atalho para começar." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,20" />
  <DockPanel Margin="0,4,0,10"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="PrevButton" Content="Anterior" /><Button x:Name="NextButton" Content="Próxima" Margin="0" /></StackPanel><TextBlock x:Name="PageText" VerticalAlignment="Center" FontSize="11" /></DockPanel>
  <TextBlock Text="Um clique abre · botão direito organiza" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,14" />
  <StackPanel Orientation="Horizontal"><RadioButton x:Name="SemiOption" GroupName="VisibilityMode" Content="Semitransparente" Foreground="{DynamicResource Text}" FontSize="11" Margin="0,0,12,0" /><RadioButton x:Name="FullOption" GroupName="VisibilityMode" Content="Totalmente visível" Foreground="{DynamicResource Text}" FontSize="11" IsChecked="True" /></StackPanel>
  <CheckBox x:Name="PinCheck" Content="Manter sobre as janelas" Foreground="{DynamicResource Text}" IsChecked="True" FontSize="11" Margin="0,8,0,0" />
  <TextBlock x:Name="Status" Text="Tudo salvo · apenas neste computador" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0" />
 </StackPanel></Border></Viewbox>
</Window>