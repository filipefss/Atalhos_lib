<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Adicionar atalho" Width="470" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" ShowInTaskbar="False">
 <StackPanel Margin="20"><TextBlock Text="Nome do atalho (opcional)" Margin="0,0,0,7" /><TextBox x:Name="NameInput" MaxLength="120" Margin="0,0,0,14" /><TextBlock Text="URL ou caminho" Margin="0,0,0,7" /><TextBox x:Name="TargetInput" Margin="0,0,0,14" /><TextBlock Text="Exemplos: https://intranet.empresa.com ou \\servidor\pasta" FontSize="11" Foreground="#AFBFD3" TextWrapping="Wrap" Margin="0,0,0,12" /><TextBlock Text="Grupo" Margin="0,0,0,7" /><TextBox x:Name="GroupInput" Text="Geral" MaxLength="80" Margin="0,0,0,14" /><TextBlock x:Name="ErrorText" Text="" Foreground="#F4BF66" TextWrapping="Wrap" Margin="0,0,0,12" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" Style="{StaticResource QuietButtonStyle}" /><Button x:Name="SaveButton" Content="Salvar" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" /></StackPanel></StackPanel>
</Window>